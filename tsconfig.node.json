{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["vite.config.js", "vitest.config.ts", "vitest.setup.ts", "eslint.config.js"]
}
